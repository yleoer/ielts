{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cijian",
  "identifier": "com.yleoer.cijian",
  "build": {
    "beforeDevCommand": "node scripts/prepare.mjs",
    "beforeBuildCommand": "node scripts/prepare.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFMUY4MkFDRUZGNTQ2RjMKUldUelJ2WHZySUlmemtJQjZUS3hHZmt3UmJUWDhvcnlUQ1NleVRrYVdHbXBlNCsydUFzRjRKbjUK",
      "endpoints": ["https://github.com/yleoer/ielts/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
