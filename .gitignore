# Python
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/

# Local environment
.env
.env.*
CODEX_ENV.md
.claude/

# Generated Anki exports
apkg-generator/anki_export/*.apkg
apkg-generator/anki_export/*.tsv
apkg-generator/anki_export/*.csv

# Runtime databases
typing-practice/backend/data/*.db
typing-practice/backend/data/*.db-*

# Original large chapter audio files. Keep split per-word files in subfolders.
apkg-generator/data/audio/*.mp3

# Keep reusable generation caches
!apkg-generator/anki_export/cache/
!apkg-generator/anki_export/cache/*.json

# Logs and temporary files
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store
