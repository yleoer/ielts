FROM python:3.12-slim-bookworm

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends tzdata wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app/backend

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app.py backend/anki.py backend/config.py backend/practice.py backend/stats.py backend/sync.py ./
RUN mkdir -p config
COPY backend/config/config.yaml ./config/config.yaml
COPY frontend ../frontend

RUN mkdir -p /app/data /app/stats /app/anki-cache \
    && chown -R app:app /app

USER app

EXPOSE 8080

ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=8080
ENV TZ=Asia/Shanghai
ENV ANKI_DB_PATH=/app/anki-cache/collection.anki2
ENV STATS_DB_PATH=/app/stats/stats.db
ENV PYTHONUNBUFFERED=1

CMD ["python", "app.py"]
