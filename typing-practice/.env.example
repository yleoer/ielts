# 复制为 .env 后按需修改，docker compose 会自动读取同目录下的 .env 文件。

# Anki 同步服务器暴露到宿主机的端口，Anki 客户端连接这个端口。
ANKI_SYNC_PORT=8081

# Anki 同步服务器登录用户名。
ANKI_SYNC_USER=ielts

# Anki 同步服务器登录密码。
ANKI_SYNC_PASSWORD=ielts

# 同步服务暴露到宿主机的端口，桌面端的 CIJIAN_SERVER_URL 指向这个端口（或其反向代理）。
TYPING_PRACTICE_PORT=8080

# 桌面端访问令牌（请求头 Authorization: Bearer <令牌>），建议使用长随机值，与桌面端配置一致。
ACCESS_TOKEN=

# 旧网页版的访问密码。ACCESS_TOKEN 为空时作为令牌使用，避免升级后服务无保护；两者都为空则不鉴权。
ACCESS_PASSWORD=

# 同步服务镜像 tag。自动部署会写入 GitHub commit sha；本地默认可用 latest。
TYPING_PRACTICE_IMAGE_TAG=latest

# 两个容器使用的时区。
TZ=Asia/Shanghai

# 从 Anki 同步数据目录复制 collection.anki2 的间隔，单位是秒。
ANKI_SYNC_INTERVAL_SECONDS=300

# 容器启动后第一次复制 Anki 数据前等待的时间，单位是秒。
ANKI_SYNC_INITIAL_WAIT_SECONDS=60
