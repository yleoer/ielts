# 复制为 .env 后按需修改，docker compose 会自动读取同目录下的 .env 文件。

# Anki 同步服务器暴露到宿主机的端口，Anki 客户端连接这个端口。
ANKI_SYNC_PORT=8081

# Anki 同步服务器登录用户名。
ANKI_SYNC_USER=ielts

# Anki 同步服务器登录密码。
ANKI_SYNC_PASSWORD=ielts

# 打字练习页面暴露到宿主机的端口，浏览器访问这个端口。
TYPING_PRACTICE_PORT=8080

# 网页访问密码。设置后首次访问需要验证，同一浏览器会长期记住；留空关闭验证。
ACCESS_PASSWORD=

# 直接运行 Python 时可指定 Anki 的 collection.media 目录；留空使用数据库同目录下的 collection.media。
# Docker 固定读取只读挂载的 data/anki-media/，无需设置此项。
ANKI_MEDIA_DIR=

# 打字练习服务镜像 tag。自动部署会写入 GitHub commit sha；本地默认可用 latest。
TYPING_PRACTICE_IMAGE_TAG=latest

# 两个容器使用的时区。
TZ=Asia/Shanghai

# 从 Anki 同步数据目录复制 collection.anki2 的间隔，单位是秒。
ANKI_SYNC_INTERVAL_SECONDS=300

# 容器启动后 Flask 应用第一次同步 Anki 数据前等待的时间，单位是秒。
ANKI_SYNC_INITIAL_WAIT_SECONDS=60
